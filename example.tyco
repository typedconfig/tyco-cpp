str environment: production
int port: 8080
bool debug: false

Server:
 *str name:
  int port:
  str host:
  - web1, 80, web1.example.com
  - api1, 3000, api1.example.com

Database:
 *str name:
  str connection_string:
  - primary, postgresql://localhost:5432/main
  - replica, postgresql://replica:5432/main